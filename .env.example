# ---------------------------------------------------------------------------
# Скопируйте файл в .env и заполните значения.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# Файл .env в git не попадает.
# ---------------------------------------------------------------------------

# --- Общее ---
APP_ENV=development              # development | test | production
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # срок жизни сессии (24 часа)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- База данных ---
# PostgreSQL внутри docker-compose
POSTGRES_USER=shelfie
POSTGRES_PASSWORD=shelfie
POSTGRES_DB=shelfie
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Строка подключения для приложения.
# Docker: postgresql+asyncpg://shelfie:shelfie@db:5432/shelfie
# Локально без Docker: sqlite+aiosqlite:///./shelfie.sqlite3
DATABASE_URL=postgresql+asyncpg://shelfie:shelfie@db:5432/shelfie

# --- Внешние источники каталога ---
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
OPENLIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1

# Кэш: сколько дней считать данные внешнего источника устаревшими
CACHE_TTL_DAYS=7
EXTERNAL_TIMEOUT_SECONDS=8

# --- Файлы ---
MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=5

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
